// WHAT A CONVERSATION COSTS AS IT GROWS — the questions asked of it on every open (how much is unread, has a colleague
// answered since) read the same whether it holds two replies or forty. Each test asks once small and once grown, and a
// read that started fetching every entry turns it red with both numbers. The desk (Ada) and Cus are in model.test.osy.
using Osysharp.Identity;
using Osysharp.Conversations;
using ConversationsKitTests;

/// ⭐ UNREAD IS COUNTED, NOT FETCHED — a customer who left forty replies unread costs the count what one did.
[Test(Desk)]
void unread_reads_the_same_however_much_is_unread() {
  runas (Ada) {
    var c = OpenConversation(PartyOf("cus@example.test"), "Long");
    UnitOfWork.Commit();
    Post(c, "Reply 1.");
    UnitOfWork.Commit();
  }
  var one = 0;
  runas (Cus) {
    var c = Conversation.Single(x => x.Subject == "Long");
    CallersSeat(c);                                        // the seat read once, outside both marks
    var mark = Cost.Mark();
    Assert.Equal(1, Unread(c));
    one = Cost.RowsReadSince(mark);
  }
  runas (Ada) {
    var c = Conversation.Single(x => x.Subject == "Long");
    for (var i = 2; i <= 40; i++) { Post(c, "Reply " + i + "."); }
    UnitOfWork.Commit();
  }
  runas (Cus) {
    var c = Conversation.Single(x => x.Subject == "Long");
    CallersSeat(c);
    var mark = Cost.Mark();
    Assert.Equal(40, Unread(c));
    var forty = Cost.RowsReadSince(mark);
    Log.Information("Unread: " + one + " rows read with 1 unread, " + forty + " with 40");
    Assert.Equal(one, forty);
  }
}

/// ⭐ "HAS A COLLEAGUE ANSWERED SINCE?" READS THE FIRST ANSWER ONLY — forty colleague replies since the mark cost the
/// question what one did, and the answer is still the first of them.
[Test(Desk)]
void answered_since_reads_the_first_answer_only() {
  Conversation? c = null;
  runas (Ada) { c = OpenConversation(PartyOf("cus@example.test"), "Busy"); UnitOfWork.Commit(); }
  var seen = 0;
  runas (Ada) { seen = ConversationEntry.Where(e => e.Conversation == c).Max(e => e.Sequence) ?? -1; }
  runas (Inbox) { Post(c!, "Answer 1."); UnitOfWork.Commit(); }
  var one = 0;
  runas (Ada) {
    var mark = Cost.Mark();
    Assert.Equal("Answer 1.", AnsweredSince(c!, seen)!.Text);
    one = Cost.RowsReadSince(mark);
  }
  runas (Inbox) {
    for (var i = 2; i <= 40; i++) { Post(c!, "Answer " + i + "."); }
    UnitOfWork.Commit();
  }
  runas (Ada) {
    var mark = Cost.Mark();
    Assert.Equal("Answer 1.", AnsweredSince(c!, seen)!.Text);
    var forty = Cost.RowsReadSince(mark);
    Log.Information("AnsweredSince: " + one + " rows read with 1 answer since, " + forty + " with 40");
    Assert.Equal(one, forty);
  }
}
