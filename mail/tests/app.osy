// The producer's test project for Osysharp.Conversations.Mail — a desk whose mail sender RECORDS what it was handed, so
// every test asserts what a carrier actually received, and what the conversation now holds.
app ConversationsMailTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Mail.Receiving@0;
  use Osysharp.Conversations@0;
  use Osysharp.Collaboration@0;
  // Osysharp.Conversations.Mail, the package under test, is not written: it arrives by itself because this app uses
  // Conversations and Mail.Receiving, which it completes (`osy lock` includes it and says so).
  use Osysharp.Workflow;
  use Osysharp.Ui;
  use Osysharp.Storage;
}

