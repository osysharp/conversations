// Osysharp.Conversations.Sms — text messages as a channel for Osysharp.Conversations.
//
// A reply the desk writes on a conversation the customer started by text goes out THROUGH Osysharp.Sms's outbox — from
// the app's number, the one the customer texted — and a text received becomes an inbound message: who it is from (their
// number, normalised), which conversation it continues. Text messages carry no threading of their own, so the kit's
// WINDOW rule threads them: a text from the same number to the same endpoint within `ThreadWindow` (seven days by
// default) continues that number's latest conversation; after it, a new one starts. A carrier's delivery report moves
// the delivery it reports on.
//
// ⚑ A BRIDGE, NOT A PART OF EITHER KIT — Sms stays usable without conversations (sign-in codes), and conversations
//   without SMS. An app that wants both names this channel:
//     app.Conversations = new ConversationsSetup { Channels = [new SmsConversationChannel { Number = "+46766861004" }] };
//
// ⚠ A NAME CANNOT BE ANSWERED. An alphanumeric sender ("Acme") is right for a one-time code and wrong for a conversation —
//   the customer's reply has nowhere to go — so this channel takes a NUMBER, and is not ready until it has one.
//
// ⚠ RECEIVING: a carrier's inbound-SMS webhook (46elks posts `from`, `to`, `message`, `id`) hands each text to
//   `ReceiveSms`, and its delivery report to `SmsDeliveryReport`. Until the platform's signed-webhook receivers land
//   (D-RECEIVE1), those are the entry points an app's own endpoint — or a test — calls.
package Osysharp.Conversations.Sms {
  version     "0.1.0";
  minPlatform "0.9.0";
  summary     "text messages as a channel for Osysharp.Conversations — replies through Osysharp.Sms's outbox from the app's own number, a text received continues that number's latest conversation within a window, carrier delivery reports, and a refusal of an alphanumeric sender that could never be answered.";
  completes   Osysharp.Conversations@0, Osysharp.Sms@0;
  model "model/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.Sms@0;
  use Osysharp.Conversations@0;
  use Osysharp.Workflow;
  use Osysharp.Ui;
  tests "tests";
}
